    </mxCell>
    <mxCell id="rel3" value="1" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmanyToOne;startArrow=ERmandOne;strokeColor=#82b366;strokeWidth=1.5;" edge="1" source="cu1" target="pm2" parent="1">
