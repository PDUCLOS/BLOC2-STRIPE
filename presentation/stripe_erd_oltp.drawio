    <!-- ═══ RELATIONS ═══ -->
    <!-- merchants→transactions passe loin (customers + payment_methods sont entre
         les deux) : entityRelationEdgeStyle ignore les waypoints manuels (testé,
         confirmé — le tracé reste diagonal à travers customers quoi qu'on mette
         dans <Array as="points">). Bascule sur orthogonalEdgeStyle, qui les
         respecte, en gardant les mêmes flèches ER (juste le routeur qui change) :
         détour explicite par le haut du schéma (y=60, tables commencent à y=90). -->
    <mxCell id="rel1" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=ERmanyToOne;startArrow=ERmandOne;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="m0r0" target="tx2" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="410" y="60" />
          <mxPoint x="850" y="60" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="rel2" value="1" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmanyToOne;startArrow=ERmandOne;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="cu1" target="tx3" parent="1">
