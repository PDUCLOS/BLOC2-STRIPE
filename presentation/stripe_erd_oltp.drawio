    <mxCell id="rel4" value="1" style="edgeStyle=entityRelationEdgeStyle;endArrow=ERmanyToOne;startArrow=ERmandOne;strokeColor=#82b366;strokeWidth=1.5;" edge="1" source="pm1" target="tx4" parent="1">
