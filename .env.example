# Stripe Polyglot - Template de variables d'environnement
# Copier en .env et remplir les valeurs (make init-env)

# ── PostgreSQL (OLTP) ──────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=stripe_oltp
PG_USER=stripe_app
PG_PASSWORD=
PG_REPLICATION_USER=replication_user
PG_REPLICATION_PASSWORD=
# Rôle en lecture seule, sans accès à payment_methods.fingerprint — cf.
# docs/SECURITY_COMPLIANCE_PLAN.md §3.2. Utilisé par le dashboard à la place
# de PG_USER si renseigné (voir dashboard/app.py).
PG_ANALYTICS_USER=analytics_reader
PG_ANALYTICS_PASSWORD=

# ── MongoDB (NoSQL) ────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=stripe_nosql
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_APP_USER=stripe_app
MONGO_APP_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────
# localhost:29092 = host (machine) → conteneur kafka via port mapping
# kafka:9092     = autre conteneur (Debezium, Flink) → DNS interne
KAFKA_BROKERS=localhost:29092
KAFKA_CONNECT_URL=http://localhost:8083

# ── Redis (Feature store online) ──────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Flink ─────────────────────────────────────────────────
FLINK_JOBMANAGER_URL=http://localhost:8081

# ── Snowflake (à remplir quand tu crées le compte trial) ─
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=STRIPE_WH
SNOWFLAKE_DB=STRIPE_DWH
SNOWFLAKE_SCHEMA=PROD

# ── App ───────────────────────────────────────────────────
FRAUD_SCORE_THRESHOLD=0.85
FEATURE_STORE_TTL=3600
TXN_PRODUCER_RATE=5
FRAUD_RATIO=0.05

# ── Dashboard (authentification) ──────────────────────────
# Contrôle d'accès au dashboard Streamlit (cf. dashboard/app.py require_login()).
# Le mot de passe n'est JAMAIS stocké en clair : seul son hash SHA-256 l'est.
# make init-env génère un mot de passe aléatoire, écrit son hash ici, et
# l'affiche UNE SEULE FOIS dans le terminal — à noter à ce moment-là.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
# Nombre d'échecs de connexion avant verrouillage temporaire (anti-bruteforce).
DASHBOARD_MAX_LOGIN_ATTEMPTS=5
DASHBOARD_LOCKOUT_SECONDS=60
